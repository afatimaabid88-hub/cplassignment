#include <iostream>
using namespace std;
int main()
{
    int a, b, c;
    cout << "Enter three numbers: ";
    cin >> a >> b >> c;
 if (a == b && b == c)
        cout << "All are equal";
    else if (a >= b && a >= c && a != b && a != c)
        cout << "A is largest";
    else if (b >= a && b >= c && b != a && b != c)
        cout << "B is largest";
    else if (c >= a && c >= b && c != a && c != b)
        cout << "C is largest";
    else
        cout << "Two numbers share the largest value";
 return 0;
}
